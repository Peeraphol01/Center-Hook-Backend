# Server
PORT=8080
CORS_ORIGIN=
SHUTDOWN_TIMEOUT_MS=15000

# Swagger /api-docs Basic auth 
API_DOCS_USERNAME=
API_DOCS_PASSWORD=

# Rate limiting 
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
LOGIN_RATE_LIMIT_MAX_REQUESTS=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Security / IP
TRUST_PROXY_HOPS=1
PROXY_SHARED_SECRET=proxy-secret-key
IP_ALLOWLIST_ADMIN=
IP_ALLOWLIST_LINE_PUSH=

# Audit log
AUDIT_LOG_RETENTION_DAYS=365
SECURITY_BRUTE_FORCE_THRESHOLD=20
SECURITY_BRUTE_FORCE_WINDOW_MINUTES=10
SECURITY_ALERT_LINE_TO=
SECURITY_ALERT_COOLDOWN_MINUTES=10

# MaxMind GeoLite2
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_DB_PATH=

# Sentry 
SENTRY_DSN=

# Forward behaviour (optional)
FORWARD_TIMEOUT_MS=10000
FORWARD_MAX_ATTEMPTS=3
FORWARD_RETRY_DELAY_MS=1000
FORWARD_LOG_RETENTION_DAYS=90

# JWT
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32_REFRESH
REFRESH_TOKEN_HASH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32_REFRESH_HASH
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=24h
ACCESS_TOKEN_REFRESH_THRESHOLD=2m

# PostgreSQL / Prisma 
DATABASE_URL=postgresql://postgres:password@localhost:5435/center_hook
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10

# LINE OA 
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
