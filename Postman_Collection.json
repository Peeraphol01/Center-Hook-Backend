    {
      "name": "Forward Logs",
      "item": [
        {
          "name": "GET /api/forward-logs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const first = pm.response.json().data?.[0];",
                  "if (first) pm.collectionVariables.set('forwardLogId', String(first.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}",
                "type": "text",
                "description": "ไม่บังคับ ใช้ค้น log ระบบส่งค่ากลับใน response header X-Request-Id และใน error body (request_id)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/forward-logs?page=1&limit=20&direction=OUTBOUND&status=FAILED&project=newlabor&line_user_id=&event_type=message&from=2026-11-01&to=2026-11-30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forward-logs"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
